rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // --- USERNAMES COLLECTION ---
    match /usernames/{username} {
      allow get, list: if true;
      allow create, update: if isValidId(username);
      allow delete: if false;
    }

    // --- USER CREDENTIALS (Salted PBKDF2 auth for zero-knowledge verify) ---
    match /user_credentials/{username} {
      allow get, list: if true;
      allow create, update: if isValidId(username);
      allow delete: if false;
    }

    // --- PUBLIC PROFILES COLLECTION ---
    match /public_profiles/{uid} {
      allow get, list: if true;
      allow create, update: if isValidId(uid);
      allow delete: if false;
    }

    // --- PREKEYS COLLECTION ---
    match /prekeys/{uid} {
      allow get, list: if true;
      allow create, update: if isValidId(uid);
      allow delete: if false;
    }

    // --- CONVERSATIONS COLLECTION ---
    match /conversations/{conversationId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(conversationId);
    }

    // --- MESSAGES COLLECTION ---
    match /messages/{messageId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(messageId);
    }
  }
}
